{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project.schema.json",
  "title": ".ai-orchestrator/project.yaml",
  "description": "The configuration of one project (project-scaffold spec 2.1): its repos, apps, Jira space, GitHub repo and Apps, optional roles, and its own allow rules for Claude Code.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "jira", "github", "repos", "apps"],
  "properties": {
    "name": {
      "description": "The name of the project on the VPS: lower-case letters, digits and hyphens.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,30}$"
    },
    "package_manager": {
      "description": "How the project installs its packages and runs its scripts (project-scaffold part 2, spec 2.1); npm when absent.",
      "enum": ["npm", "pnpm"]
    },
    "jira": {
      "type": "object",
      "additionalProperties": false,
      "required": ["space"],
      "properties": {
        "space": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,9}$" }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "approvers", "apps"],
      "properties": {
        "repo": { "$ref": "#/$defs/repo" },
        "approvers": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" } },
        "apps": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dev", "dev_id", "review", "review_id"],
          "properties": {
            "dev": { "$ref": "#/$defs/slug" },
            "dev_id": { "$ref": "#/$defs/id" },
            "review": { "$ref": "#/$defs/slug" },
            "review_id": { "$ref": "#/$defs/id" }
          }
        },
        "kit_peers": { "type": "array", "items": { "$ref": "#/$defs/repo" } }
      }
    },
    "repos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "apps": {
      "description": "The apps of the project; none until ao-kit add brings the first one to a pnpm project (project-scaffold part 2, spec 2.2).",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/app" }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "optional": { "type": "array", "items": { "type": "string" } }
      }
    },
    "claude": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "$defs": {
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "host": { "type": "string", "maxLength": 253, "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$" },
    "id": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "string", "pattern": "^[0-9]+$" }] },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "path", "profile", "dev", "port", "health"],
      "properties": {
        "repo": { "type": "string" },
        "path": { "type": "string", "minLength": 1 },
        "profile": { "description": "The stack of the app; react since project-scaffold part 2, B3 adds spring-boot.", "enum": ["nextjs", "nestjs", "react"] },
        "dev": { "description": "The command that runs the app on this machine, npm, pnpm or node with no shell.", "type": "string" },
        "port": {
          "type": "object",
          "additionalProperties": false,
          "required": ["env", "default"],
          "properties": {
            "env": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" },
            "default": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "health": { "description": "The path that answers 200 once the app is up.", "type": "string", "pattern": "^/" },
        "public": { "type": "boolean" },
        "hosts": {
          "description": "The host of a public app in each environment, the same as under projects of /etc/ao/deployer.yaml on the VPS: qa reaches the app there, and ao-kit doctor prints those lines (project-scaffold part 2, spec 2.4).",
          "type": "object",
          "additionalProperties": false,
          "required": ["development", "staging", "production"],
          "properties": {
            "development": { "$ref": "#/$defs/host" },
            "staging": { "$ref": "#/$defs/host" },
            "production": { "$ref": "#/$defs/host" }
          }
        },
        "env": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  }
}
