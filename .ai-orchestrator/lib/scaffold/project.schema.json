{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project.schema.json",
  "title": ".ai-orchestrator/project.yaml",
  "description": "The configuration of one project (project-scaffold spec 2.1): its repos, apps, Jira space, GitHub repo and Apps, optional roles, and its own allow rules for Claude Code.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "jira", "github", "repos", "apps"],
  "properties": {
    "name": {
      "description": "The name of the project on the VPS: lower-case letters, digits and hyphens.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,30}$"
    },
    "package_manager": {
      "description": "How the project installs its packages and runs its scripts (project-scaffold part 2, spec 2.1); npm when absent.",
      "enum": ["npm", "pnpm"]
    },
    "jira": {
      "type": "object",
      "additionalProperties": false,
      "required": ["space"],
      "properties": {
        "space": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,9}$" }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "approvers", "apps"],
      "properties": {
        "repo": { "$ref": "#/$defs/repo" },
        "approvers": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" } },
        "apps": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dev", "dev_id", "review", "review_id"],
          "dependentRequired": { "merge": ["merge_id"], "merge_id": ["merge"] },
          "properties": {
            "dev": { "$ref": "#/$defs/slug" },
            "dev_id": { "$ref": "#/$defs/id" },
            "review": { "$ref": "#/$defs/slug" },
            "review_id": { "$ref": "#/$defs/id" },
            "merge": { "description": "merge-gate's own App (Pilot 3, spec 2.9): the only one the rulesets let merge without your approval; its key lives only in the merge-gate environment.", "$ref": "#/$defs/slug" },
            "merge_id": { "$ref": "#/$defs/id" }
          }
        },
        "kit_peers": { "type": "array", "items": { "$ref": "#/$defs/repo" } }
      }
    },
    "repos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "apps": {
      "description": "The apps of the project; none until ao-kit add brings the first one to a pnpm project (project-scaffold part 2, spec 2.2).",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/app" }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approved": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ecosystem", "name", "range", "by", "on"],
            "additionalProperties": false,
            "properties": {
              "ecosystem": { "enum": ["npm", "maven"] },
              "name": { "type": "string", "minLength": 1 },
              "range": { "type": "string", "minLength": 1 },
              "by": { "type": "string", "minLength": 1 },
              "on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
            }
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["advisory", "reason", "expires"],
            "additionalProperties": false,
            "properties": {
              "advisory": { "type": "string", "pattern": "^GHSA(-[23456789cfghjmpqrvwx]{4}){3}$" },
              "reason": { "type": "string", "minLength": 1 },
              "expires": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
            }
          }
        }
      }
    },
    "review": {
      "description": "Paths the project adds to a review tier of quality/gates.yaml (review of shop PR #79): its own files that decide who calls, or what the browser runs. They only add to the kit's lists.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "critical_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "sensitive_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "optional": { "type": "array", "items": { "type": "string" } }
      }
    },
    "claude": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "runs": {
      "description": "Where agent runs work (parallel-runs spec). worktrees: the build and fix of each item run in a worktree of their own, next to the project folder. copy: files git does not track that a new worktree needs, relative to the project and inside it.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "worktrees": { "type": "boolean" },
        "lanes_max": { "type": "integer", "minimum": 1, "maximum": 6, "description": "How many items have a lane at once, and how many agents run at once; from 2 it needs worktrees" },
        "min_free_ram_gb": { "type": "number", "minimum": 0, "maximum": 64, "description": "Free RAM another agent needs to start; 0 turns the check off" },
        "port_step": { "type": "integer", "minimum": 10, "maximum": 1000, "description": "How far the ports of each lane move from the defaults" },
        "budget_usd": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000, "description": "The budget of one /ao-run: once the runs it started cost this much, it starts no command more (C2 spec 5.5)" },
        "idle_hours": { "type": "integer", "minimum": 1, "maximum": 48, "description": "How long /ao-run waits for you when nothing can start, before it ends (C2 spec 5.4)" },
        "agents_per_role": {
          "description": "How many agents of a dev role work at once, each on its own item in its own lane: at most lanes_max. A role not named keeps 1 (C2 spec section 6)",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "be-dev": { "type": "integer", "minimum": 1, "maximum": 6 },
            "fe-dev": { "type": "integer", "minimum": 1, "maximum": 6 },
            "devops": { "type": "integer", "minimum": 1, "maximum": 6 }
          }
        },
        "copy": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "pattern": "^(?![\\\\/])(?![A-Za-z]:)(?!(.*[\\\\/])?\\.\\.([\\\\/]|$)).+$" }
        },
        "lane_env": {
          "description": "Variables each lane gets its own value of, before the .env files: ports moved like the ports of the apps, names ending in -s<slot>, such as the project, container and port of a database in Docker Compose",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ports": {
              "type": "object",
              "propertyNames": { "pattern": "^[A-Z_][A-Z0-9_]*$" },
              "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 59535 }
            },
            "names": {
              "type": "object",
              "propertyNames": { "pattern": "^[A-Z_][A-Z0-9_]*$" },
              "additionalProperties": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,60}$" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "host": { "type": "string", "maxLength": 253, "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$" },
    "id": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "string", "pattern": "^[0-9]+$" }] },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "path", "profile", "dev", "port", "health"],
      "properties": {
        "repo": { "type": "string" },
        "path": { "type": "string", "minLength": 1 },
        "profile": { "description": "The stack of the app; react since project-scaffold part 2, spring-boot since part 3.", "enum": ["nextjs", "nestjs", "react", "spring-boot"] },
        "dev": { "description": "The command that runs the app on this machine, npm, pnpm or node with no shell.", "type": "string" },
        "port": {
          "type": "object",
          "additionalProperties": false,
          "required": ["env", "default"],
          "properties": {
            "env": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" },
            "default": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "health": { "description": "The path that answers 200 once the app is up.", "type": "string", "pattern": "^/" },
        "coverage_exclude": {
          "description": "Globs of the app folder that the coverage of changed lines leaves out, as the coverage config of the app does, such as src/main/java/**/dto/** (project-scaffold part 3, spec 2.3). This file is a protected path, so only a PR you merge widens the list.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(?![/\\\\])(?!.*(^|/)\\.\\.(/|$))\\S+$" }
        },
        "public": { "type": "boolean" },
        "seo": {
          "description": "A search engine indexes the pages of this app, so seo writes the SEO of its screens at stage spec (C1 spec 6.1). Only a public app; an admin app has false.",
          "type": "boolean"
        },
        "hosts": {
          "description": "The host of a public app in each environment, the same as under projects of /etc/ao/deployer.yaml on the VPS: qa reaches the app there, and ao-kit doctor prints those lines (project-scaffold part 2, spec 2.4).",
          "type": "object",
          "additionalProperties": false,
          "required": ["development", "staging", "production"],
          "properties": {
            "development": { "$ref": "#/$defs/host" },
            "staging": { "$ref": "#/$defs/host" },
            "production": { "$ref": "#/$defs/host" }
          }
        },
        "env": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  }
}
