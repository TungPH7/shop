{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "policies.yaml",
  "description": "Limits, error handling, retro metrics, the artifact catalog and languages (spec sections 2.4 and 2.7-2.9).",
  "type": "object",
  "required": ["rework", "wip_limits", "retry", "error_handling", "metrics", "artifacts", "artifact_notes", "language"],
  "additionalProperties": false,
  "properties": {
    "rework": {
      "type": "object",
      "required": ["limit", "on_limit"],
      "additionalProperties": false,
      "properties": {
        "limit": { "type": "integer", "minimum": 1 },
        "on_limit": { "$ref": "#/$defs/id" }
      }
    },
    "wip_limits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "scope", "limit"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "scope": { "$ref": "#/$defs/text" },
          "limit": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "retry": {
      "type": "object",
      "required": ["flaky_ci_reruns", "agent_failures_before_stop"],
      "additionalProperties": false,
      "properties": {
        "flaky_ci_reruns": { "type": "integer", "minimum": 0 },
        "agent_failures_before_stop": { "type": "integer", "minimum": 1 }
      }
    },
    "error_handling": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["situation", "action"],
        "additionalProperties": false,
        "properties": {
          "situation": { "$ref": "#/$defs/text" },
          "action": { "$ref": "#/$defs/text" }
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "definition"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "$ref": "#/$defs/text" },
          "definition": { "$ref": "#/$defs/text" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "artifact_notes": {
      "type": "array",
      "items": { "$ref": "#/$defs/text" }
    },
    "language": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["what", "language"],
        "additionalProperties": false,
        "properties": {
          "what": { "$ref": "#/$defs/text" },
          "language": { "enum": ["en", "vi"] }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "text": { "type": "string", "minLength": 1 },
    "artifact": {
      "type": "object",
      "required": ["id", "name", "template", "created_by", "stored_in"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "template": { "type": "string", "pattern": "^templates/[a-z0-9-]+\\.md$" },
        "created_by": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/id" }
            },
            { "enum": ["reporter", "assignee"] }
          ]
        },
        "stored_in": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/storage" }
        }
      }
    },
    "storage": {
      "type": "object",
      "required": ["place"],
      "additionalProperties": false,
      "properties": {
        "place": { "enum": ["git", "tracker", "github-pr", "local", "google-drive"] },
        "path": { "$ref": "#/$defs/text" },
        "note": { "$ref": "#/$defs/text" }
      },
      "anyOf": [{ "required": ["path"] }, { "required": ["note"] }]
    }
  }
}
