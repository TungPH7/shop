{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "stages.yaml",
  "description": "Stages, approval gates, environments, the working cadence and the release rules (spec sections 2.2, 2.6 and 2.7).",
  "type": "object",
  "required": ["gates", "stages", "environments", "cadence", "release_rules"],
  "additionalProperties": false,
  "properties": {
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gate" }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stage" }
    },
    "environments": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/environment" }
    },
    "cadence": {
      "type": "object",
      "required": ["method", "schedule"],
      "additionalProperties": false,
      "properties": {
        "method": { "$ref": "#/$defs/text" },
        "schedule": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["when", "what"],
            "additionalProperties": false,
            "properties": {
              "when": { "$ref": "#/$defs/text" },
              "what": { "$ref": "#/$defs/text" },
              "gates": { "$ref": "#/$defs/ids" }
            }
          }
        }
      }
    },
    "release_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "text"],
        "additionalProperties": false,
        "properties": {
          "title": { "$ref": "#/$defs/text" },
          "text": { "$ref": "#/$defs/text" }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "text": { "type": "string", "minLength": 1 },
    "gate": {
      "type": "object",
      "required": ["id", "number", "approvers", "description"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "number": { "type": "integer", "minimum": 1, "maximum": 20 },
        "approvers": { "$ref": "#/$defs/ids" },
        "description": { "$ref": "#/$defs/text" }
      }
    },
    "stage": {
      "type": "object",
      "required": ["id", "name", "roles", "input", "outputs"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "roles": { "$ref": "#/$defs/ids" },
        "lead": { "$ref": "#/$defs/id" },
        "note": { "$ref": "#/$defs/text" },
        "input": { "$ref": "#/$defs/text" },
        "guards": { "$ref": "#/$defs/ids" },
        "outputs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "artifacts": { "$ref": "#/$defs/ids" },
            "other": { "$ref": "#/$defs/text" }
          },
          "anyOf": [{ "required": ["artifacts"] }, { "required": ["other"] }]
        },
        "exit": { "$ref": "#/$defs/text" },
        "gate": { "$ref": "#/$defs/id" }
      },
      "anyOf": [{ "required": ["exit"] }, { "required": ["gate"] }]
    },
    "environment": {
      "type": "object",
      "required": ["id", "name", "branches", "deploy", "data"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "branches": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/text" }
        },
        "tagged": { "type": "boolean" },
        "deploy": { "$ref": "#/$defs/text" },
        "data": { "$ref": "#/$defs/text" }
      }
    }
  }
}
