{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "roles.yaml",
  "description": "Roles that take part in the SDLC (spec section 2.1).",
  "type": "object",
  "required": ["roles"],
  "additionalProperties": false,
  "properties": {
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/role" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "role": {
      "type": "object",
      "required": ["id", "name", "responsibilities"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "responsibilities": { "type": "string", "minLength": 1 }
      }
    }
  }
}
