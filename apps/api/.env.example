# ===================================================================
# .env.example — template cho biến môi trường local development.
# COPY file này thành '.env' và điền giá trị thật.
# KHÔNG commit '.env' lên Git.
# ===================================================================

# -------------------- PostgreSQL (container) --------------------
# Tên container & service (dùng làm hostname trong Docker network)
POSTGRES_CONTAINER_NAME=learn-postgres

# Image & version
POSTGRES_IMAGE=postgres:17-alpine

# Cổng host expose (tránh conflict nếu máy đã có Postgres khác chạy 5432)
POSTGRES_HOST_PORT=5432

# Database & credentials
# (cho dev: dùng giá trị đơn giản; production: dùng secret manager)
POSTGRES_DB=learn_postgres_db
POSTGRES_USER=learn_postgres_user
POSTGRES_PASSWORD=change_me_in_real_env

# Superuser (dùng để tạo role/db ban đầu — KHÔNG dùng cho app)
POSTGRES_ROOT_USER=postgres
POSTGRES_ROOT_PASSWORD=change_me_in_real_env_root

# Locale & encoding
POSTGRES_INITDB_ARGS="--encoding=UTF-8 --locale=C"

# Timezone
TZ=Asia/Ho_Chi_Minh

# -------------------- Spring Boot --------------------
# Các biến này được docker-compose.yml ignore, nhưng app Spring Boot sẽ đọc.
# Để chung 1 file để dễ quản lý.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# -------------------- Spring Boot DataSource --------------------
# Host & port mà APP kết nối tới DB.
# - Khi app chạy ngoài Docker (IDE): DB_HOST=localhost, DB_PORT=POSTGRES_HOST_PORT.
# - Khi app chạy trong Docker compose stack: DB_HOST=postgres, DB_PORT=5432.
DB_HOST=localhost
DB_PORT=5432

# (POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD đã khai báo ở block trên — tái sử dụng)

# -------------------- Errors & API doc -------------
# URI prefix cho `type` field trong RFC 7807 ProblemDetail response.
APP_ERRORS_BASE_URL=https://docs.example.com/errors

# -------------------- Logging & Correlation Id ---------
APP_LOGGING_CORRELATION_ID_HEADER=X-Correlation-Id
APP_LOGGING_CORRELATION_ID_MDC_KEY=correlationId
APP_LOGGING_MAX_CORRELATION_ID_LENGTH=128

# -------------------- Security: CORS -------------------
# Dev: localhost frontend. Prod: thay bằng domain thật.
# Comma-separated, KHÔNG wildcard nếu allow-credentials=true.
APP_SECURITY_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
APP_SECURITY_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
APP_SECURITY_CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Correlation-Id
APP_SECURITY_CORS_EXPOSED_HEADERS=X-Correlation-Id,Location
APP_SECURITY_CORS_ALLOW_CREDENTIALS=false
APP_SECURITY_CORS_MAX_AGE_SECONDS=3600

# -------------------- Security: Headers ----------------
# CSP dev: Swagger UI cần unsafe-inline. Prod: profile prod override csp → default-src 'self'.
APP_SECURITY_HEADERS_CSP="default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
APP_SECURITY_HEADERS_REFERRER_POLICY=no-referrer
APP_SECURITY_HEADERS_PERMISSIONS_POLICY="geolocation=(), camera=(), microphone=()"
APP_SECURITY_HEADERS_HSTS_MAX_AGE=31536000
APP_SECURITY_HEADERS_HSTS_INCLUDE_SUBDOMAINS=true
# Dev: false. Prod: profile prod override → true (submit hstspreload.org).
APP_SECURITY_HEADERS_HSTS_PRELOAD=false

# -------------------- Compose app service --------------
APP_VERSION=0.0.1-SNAPSHOT
APP_HOST_PORT=8080
APP_PROFILE=prod                        # local dev có thể đổi 'dev'
COMPOSE_NETWORK_NAME=learn-app-network

# Build metadata — CI sẽ inject thật
BUILD_DATE=unknown
GIT_COMMIT=unknown