<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="false">

    <springProperty scope="context" name="appName"
                    source="spring.application.name" defaultValue="learn-postgresql-api"/>
    <springProperty scope="context" name="appEnv"
                    source="spring.profiles.active" defaultValue="default"/>

    <!-- ============================================================== -->
    <!-- Appender 1: JSON for prod + dev by default                      -->
    <!-- ============================================================== -->
    <appender name="JSON_CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <fieldName>@timestamp</fieldName>
                    <timeZone>UTC</timeZone>
                </timestamp>
                <version>
                    <fieldName>@version</fieldName>
                </version>
                <pattern>
                    <pattern>
                        {
                            "app": "${appName}",
                            "env": "${appEnv}"
                        }
                    </pattern>
                </pattern>
                <logLevel>
                    <fieldName>level</fieldName>
                </logLevel>
                <loggerName>
                    <fieldName>logger</fieldName>
                    <shortenedLoggerNameLength>40</shortenedLoggerNameLength>
                </loggerName>
                <threadName>
                    <fieldName>thread</fieldName>
                </threadName>
                <message>
                    <fieldName>message</fieldName>
                </message>
                <mdc/>                                <!-- hoist every MDC field to top-level -->
                <arguments/>                          <!-- log.info("x={}", kv("x", 1)) → field "x":1 -->
                <stackTrace>
                    <fieldName>stackTrace</fieldName>
                    <throwableConverter
                            class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                        <maxDepthPerThrowable>30</maxDepthPerThrowable>
                        <maxLength>4096</maxLength>
                        <rootCauseFirst>true</rootCauseFirst>
                    </throwableConverter>
                </stackTrace>
            </providers>
        </encoder>
    </appender>

    <!-- ============================================================== -->
    <!-- Appender 2: Pretty text — only enabled with the 'pretty-log' profile -->
    <!-- ============================================================== -->
    <appender name="PRETTY_CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) [%X{correlationId:-no-corr-id}] %cyan(%logger{36}) - %msg%n%ex</pattern>
        </encoder>
    </appender>

    <!-- ============================================================== -->
    <!-- Profile routing                                                 -->
    <!-- ============================================================== -->

    <springProfile name="pretty-log">
        <root level="INFO">
            <appender-ref ref="PRETTY_CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="!pretty-log">
        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE"/>
        </root>
    </springProfile>

</configuration>