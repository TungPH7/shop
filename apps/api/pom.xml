<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.9</version>
        <relativePath/>
        <!-- lookup parent from repository -->
    </parent>
    <groupId>com.tungph7.learnpostgres</groupId>
    <artifactId>learn-postgresql-api</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name/>
    <description/>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>21</java.version>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <mapstruct.version>1.6.3</mapstruct.version>
        <springdoc.version>3.0.3</springdoc.version>
        <logstash-logback-encoder.version>8.1</logstash-logback-encoder.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <spotless-maven-plugin.version>2.43.0</spotless-maven-plugin.version>
        <google-java-format.version>1.22.0</google-java-format.version>
        <quality.skip>false</quality.skip>
        <!-- Per-plugin skip flags — default kế thừa từ master quality.skip.
		     Override độc lập từng plugin qua CLI:
		       mvn verify -Dspotless.skip=true -Dcheckstyle.skip=true   # only jacoco
		       mvn verify -Djacoco.skip=true                            # only spotless+checkstyle -->
        <spotless.skip>${quality.skip}</spotless.skip>
        <checkstyle.skip>${quality.skip}</checkstyle.skip>
        <jacoco.skip>${quality.skip}</jacoco.skip>
        <jacoco-maven-plugin.version>0.8.12</jacoco-maven-plugin.version>
        <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
        <!-- Override commons-lang3.version để giải quyết RequireUpperBoundDeps:
		     Spring Boot 4.0.6 BOM pin 3.19.0 (older), nhưng swagger-core-jakarta
		     (qua springdoc) require 3.20.0. Set property này → BOM resolve 3.20.0,
		     enforcer pass. Xem QnA-2 câu 1. -->
        <commons-lang3.version>3.20.0</commons-lang3.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- ============================================================== -->
        <!-- Persistence: Spring Data JPA + PostgreSQL JDBC driver           -->
        <!-- HikariCP (connection pool) đi kèm starter-data-jpa, không cần   -->
        <!-- khai báo riêng.                                                  -->
        <!-- ============================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ============================================================== -->
        <!-- Database Migration — Flyway (folder 04)                         -->
        <!--   - flyway-core: engine generic                                  -->
        <!--   - flyway-database-postgresql: plugin Postgres-specific         -->
        <!--     (Postgres ≥ 10, support pgAdvisoryLock, JSON, ...)            -->
        <!-- ============================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Bean Validation (Hibernate Validator implementation) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- MapStruct runtime -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>${logstash-logback-encoder.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- (Optional) test starter — folder 11 sẽ dùng đầy đủ -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Folder 11: @DataJpaTest + @AutoConfigureTestDatabase cho repository slice test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers 2.x JUnit 5 extension (@Testcontainers, @Container lifecycle) -->
        <!-- Module name có prefix 'testcontainers-' từ TC 2.0 (breaking change) -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers 2.x PostgreSQL module (PostgreSQLContainer) -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Spring Boot Testcontainers: @ServiceConnection auto-bind container → spring.datasource.* -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>0.2.0</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-Amapstruct.defaultComponentModel=spring</arg>
                        <arg>-Amapstruct.unmappedTargetPolicy=ERROR</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless-maven-plugin.version}</version>
                <configuration>
                    <skip>${spotless.skip}</skip>
                    <java>
                        <includes>
                            <include>src/main/java/**/*.java</include>
                            <include>src/test/java/**/*.java</include>
                        </includes>
                        <toggleOffOn/>
                        <googleJavaFormat>
                            <version>${google-java-format.version}</version>
                            <style>GOOGLE</style>
                            <reflowLongStrings>true</reflowLongStrings>
                        </googleJavaFormat>
                        <removeUnusedImports/>
                        <importOrder>
                            <order>java,javax,jakarta,org,com,</order>
                        </importOrder>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                    </java>
                    <pom>
                        <includes>
                            <include>pom.xml</include>
                        </includes>
                        <sortPom>
                            <expandEmptyElements>false</expandEmptyElements>
                            <nrOfIndentSpace>4</nrOfIndentSpace>
                        </sortPom>
                    </pom>
                    <yaml>
                        <includes>
                            <include>src/**/*.yml</include>
                            <include>src/**/*.yaml</include>
                            <include>docker-compose.yml</include>
                        </includes>
                        <jackson/>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                    </yaml>
                    <markdown>
                        <includes>
                            <include>**/*.md</include>
                        </includes>
                        <excludes>
                            <exclude>.claude/**</exclude>
                        </excludes>
                        <flexmark/>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                    </markdown>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>validate</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <skip>${checkstyle.skip}</skip>
                    <configLocation>checkstyle.xml</configLocation>
                    <suppressionsLocation>checkstyle-suppressions.xml</suppressionsLocation>
                    <suppressionsFileExpression>checkstyle.suppressions.file</suppressionsFileExpression>
                    <consoleOutput>true</consoleOutput>
                    <violationSeverity>error</violationSeverity>
                    <linkXRef>false</linkXRef>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>10.18.1</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>checkstyle-validation</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>validate</phase>
                        <configuration>
                            <!-- Enforcement flags chỉ áp dụng khi bound vào phase `validate`.
							     Đặt trong plugin-level <configuration> sẽ kéo theo cả goal
							     `checkstyle:checkstyle` (report HTML) — khiến report goal cũng
							     fail trước khi ghi HTML khi có violation. -->
                            <failsOnError>true</failsOnError>
                            <failOnViolation>true</failOnViolation>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-maven-plugin.version}</version>
                <configuration>
                    <skip>${jacoco.skip}</skip>
                    <excludes>
                        <!-- Main class — chỉ có @SpringBootApplication, không cần test -->
                        <exclude>com/tungph7/learnpostgres/LearnPostgresqlApiApplication.class</exclude>
                        <!-- DTO record — chỉ field, no logic -->
                        <exclude>com/tungph7/learnpostgres/feature/**/dto/**</exclude>
                        <!-- DTO record / response wrappers ở common -->
                        <exclude>com/tungph7/learnpostgres/common/dto/**</exclude>
                        <!-- MapStruct generated impl -->
                        <exclude>**/*MapperImpl.class</exclude>
                        <!-- @Configuration class chỉ wire bean -->
                        <exclude>com/tungph7/learnpostgres/common/config/**</exclude>
                        <!-- Properties record (có private constructor / canonical) -->
                        <exclude>**/*Properties.class</exclude>
                        <!-- Nested SecurityProperties.* (Headers, Cors, Hsts) — pure config records -->
                        <exclude>com/tungph7/learnpostgres/common/security/SecurityProperties$*.class</exclude>
                        <!-- ErrorCode enum — value class -->
                        <exclude>com/tungph7/learnpostgres/common/error/ErrorCode.class</exclude>
                        <!-- OpenAPI doc customizer — chỉ build schema metadata, không có business logic -->
                        <exclude>com/tungph7/learnpostgres/common/error/ProblemDetailOpenApiCustomizer.class</exclude>
                        <!-- Unused exception subclass placeholder -->
                        <exclude>com/tungph7/learnpostgres/common/error/BadRequestException.class</exclude>
                        <!-- Hibernate custom UserType — boilerplate JDBC binding -->
                        <exclude>com/tungph7/learnpostgres/common/domain/CitextType.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                    <execution>
                        <id>jacoco-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                        <configuration>
                            <rules>
                                <!-- Bundle level: toàn dự án -->
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.60</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <!-- Service: critical, threshold cao hơn -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.tungph7.learnpostgres.feature.*.service</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.85</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <!-- Controller -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.tungph7.learnpostgres.feature.*.controller</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <!-- Class level: chấp nhận 1-2 class có coverage thấp, nhưng không quá thấp -->
                                <rule>
                                    <element>CLASS</element>
                                    <excludes>
                                        <exclude>com.tungph7.learnpostgres.LearnPostgresqlApiApplication</exclude>
                                        <exclude>*MapperImpl</exclude>
                                        <exclude>*Config</exclude>
                                        <exclude>*Properties</exclude>
                                    </excludes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>MISSEDCOUNT</value>
                                            <maximum>30</maximum>
                                            <!-- mỗi class miss < 30 line -->
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                            <haltOnFailure>true</haltOnFailure>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <phase>validate</phase>
                        <configuration>
                            <skip>${quality.skip}</skip>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,22)</version>
                                    <message>Project requires Java 21 LTS.</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <dependencyConvergence/>
                                <requireUpperBoundDeps/>
                                <bannedDependencies>
                                    <excludes>
                                        <!-- JUnit 4 — project dùng JUnit 5 -->
                                        <exclude>junit:junit</exclude>
                                        <!-- Log4j 1.x — EOL từ 2015 -->
                                        <exclude>log4j:log4j</exclude>
                                        <!-- Bridge legacy -->
                                        <exclude>org.slf4j:slf4j-log4j12</exclude>
                                        <exclude>org.apache.logging.log4j:log4j-1.2-api</exclude>
                                        <!-- Spring 7 đã bỏ spring-jcl shim → spring-core pull commons-logging
										     làm transitive thật. KHÔNG ban được nữa (Spring 4-6 thì có thể).
										     Nếu cần kiểm soát, exclude ở dep gây ra thay vì ban toàn cục.
										     <exclude>commons-logging:commons-logging</exclude> -->
                                        <!-- HikariCP duplicate -->
                                        <exclude>com.zaxxer:HikariCP-java6</exclude>
                                        <exclude>com.zaxxer:HikariCP-java7</exclude>
                                        <!-- Mockito JUnit 4 runner -->
                                        <exclude>org.mockito:mockito-all</exclude>
                                    </excludes>
                                </bannedDependencies>
                                <reactorModuleConvergence/>
                                <requireProfileIdsExist/>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
