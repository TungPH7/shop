{
  "name": "shop",
  "version": "0.1.0",
  "private": true,
  "description": "Shop: the apps in apps/, one pnpm workspace, set up with ai-orchestrator",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test:coverage": "pnpm -r run test:coverage",
    "build": "pnpm -r run build",
    "test:e2e": "playwright test",
    "prepare": "node .ai-orchestrator/scripts/install-hooks.mjs",
    "precommit": "lint-staged"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "yaml": "2.9.1",
    "lint-staged": "17.0.8"
  }
}
